#[cfg(test)]
mod tests {
    use super::*;
    use kornia_3d::ba::BaObservation;
    use kornia_3d::camera::PinholeCamera;
    use kornia_algebra::Mat3F64;
    use crate::imu::{ImuCalib, ImuMeasurement};

    fn test_camera() -> PinholeCamera {
        PinholeCamera {
            fx: 500.0, fy: 500.0, cx: 320.0, cy: 240.0,
            k1: 0.0, k2: 0.0, p1: 0.0, p2: 0.0,
        }
    }

    fn euroc_calib() -> ImuCalib {
        ImuCalib {
            gyro_noise: 1.6968e-4,
            accel_noise: 2.0e-3,
            gyro_bias_noise: 1.9393e-5,
            accel_bias_noise: 3.0e-3,
        }
    }

    /// Build a PreintegratedImu for a camera moving at constant velocity
    /// `vel` (m/s, world frame) for duration `duration` seconds at `rate` Hz.
    /// The camera is upright so accelerometer reads +g upward.
    fn make_preintegrated(
        vel: Vec3F64,
        duration: f64,
        rate: f64,
        bias: ImuBias,
        calib: ImuCalib,
    ) -> PreintegratedImu {
        let dt = 1.0 / rate;
        let n = (duration * rate).round() as usize;
        let mut pim = PreintegratedImu::new(bias, calib);
        for k in 0..n {
            let m = ImuMeasurement {
                timestamp: k as f64 * dt,
                gyro: Vec3F64::ZERO,
                // Accelerometer must read +g to cancel gravity in the body frame
                // (stationary or constant-velocity — no inertial acceleration).
                accel: Vec3F64::new(0.0, 0.0, 9.81),
            };
            pim.integrate(&m, dt);
        }
        pim
    }

    /// Constant-velocity VI-BA test:
    /// 3 keyframes moving at 0.5 m/s along X. IMU preintegration is
    /// built from zero-gyro, +g-accel measurements. Points are in front.
    /// We perturb velocities and biases and check VI-BA recovers them.
    #[test]
    fn viba_constant_velocity_recovery() {
        let cam = test_camera();
        let calib = euroc_calib();
        let bias = ImuBias::default();
        let gravity = Vec3F64::new(0.0, 0.0, -9.81);

        let vel = Vec3F64::new(0.5, 0.0, 0.0);
        let dt_kf = 0.2; // 5 Hz keyframe rate
        let n_kf = 3usize;

        // Ground truth keyframes: pose = identity rotation, translation along X.
        let true_kfs: Vec<ViBaKeyframe> = (0..n_kf)
            .map(|i| {
                let t_world = vel * (i as f64 * dt_kf); // camera centre in world
                ViBaKeyframe {
                    // R_WC = I, t_WC = t_world → R_CW = I, t_CW = -t_world
                    pose: Pose3d::new(Mat3F64::IDENTITY, Vec3F64::new(-t_world.x, 0.0, 0.0)),
                    velocity: vel,
                    bias,
                    fixed: i == 0, // anchor first frame
                }
            })
            .collect();

        // Ground truth points in a 3×3 grid at Z=4m.
        let true_points: Vec<Vec3F64> = (-1..=1)
            .flat_map(|ix| {
                (-1..=1).map(move |iy| {
                    Vec3F64::new(ix as f64 * 0.5, iy as f64 * 0.5, 4.0)
                })
            })
            .collect();

        // Build visual observations.
        let project = |kf: &ViBaKeyframe, pw: &Vec3F64| -> [f32; 2] {
            let pc = kf.pose.transform_point(pw);
            let u = cam.fx * pc.x / pc.z + cam.cx;
            let v = cam.fy * pc.y / pc.z + cam.cy;
            [u as f32, v as f32]
        };

        let mut observations = Vec::new();
        for (ki, kf) in true_kfs.iter().enumerate() {
            for (pi, pt) in true_points.iter().enumerate() {
                let pc = kf.pose.transform_point(pt);
                if pc.z < 0.5 { continue; }
                observations.push(BaObservation {
                    pose_idx: ki,
                    point_idx: pi,
                    pixel: project(kf, pt),
                    fixed_pose: ki == 0,
                    fixed_point: false,
                    ..BaObservation::default()
                });
            }
        }

        // Build IMU edges between consecutive keyframes.
        let imu_edges: Vec<ImuEdge> = (0..n_kf - 1)
            .map(|k| ImuEdge {
                from_idx: k,
                to_idx: k + 1,
                preintegrated: make_preintegrated(vel, dt_kf, 200.0, bias, calib),
            })
            .collect();

        // Perturb velocities and biases (not the anchor frame).
        let init_kfs: Vec<ViBaKeyframe> = true_kfs
            .iter()
            .enumerate()
            .map(|(i, kf)| {
                if i == 0 { return kf.clone(); }
                ViBaKeyframe {
                    pose: kf.pose,
                    // Perturb velocity by 0.1 m/s.
                    velocity: Vec3F64::new(kf.velocity.x + 0.1, kf.velocity.y, kf.velocity.z),
                    // Perturb gyro bias by 0.01 rad/s.
                    bias: ImuBias {
                        gyro: Vec3F64::new(0.01, 0.0, 0.0),
                        accel: Vec3F64::ZERO,
                    },
                    fixed: kf.fixed,
                }
            })
            .collect();

        let params = ViBaParams {
            max_iterations: 30,
            initial_lambda: 1e-3,
            cost_tolerance: 1e-7,
            gravity,
        };

        let result = visual_inertial_bundle_adjust(
            &init_kfs,
            &true_points, // points start at GT (test focuses on pose/vel/bias)
            &observations,
            &imu_edges,
            &cam,
            &params,
        )
        .unwrap();

        assert!(result.converged || result.iterations < params.max_iterations,
            "VI-BA did not converge in {} iterations", result.iterations);

        // Check velocity recovery.
        for (i, kf) in result.keyframes.iter().enumerate() {
            if i == 0 { continue; }
            let dv = (kf.velocity - vel).length();
            assert!(dv < 0.05, "keyframe {i} velocity error {dv:.4} m/s too large");
        }

        // Check gyro bias recovery.
        for (i, kf) in result.keyframes.iter().enumerate() {
            if i == 0 { continue; }
            let db = kf.bias.gyro.length();
            assert!(db < 0.01, "keyframe {i} gyro bias error {db:.6} rad/s too large");
        }
    }

    /// Jacobian sanity test: compare analytical IMU Jacobians against
    /// numerical finite differences.
    #[test]
    fn imu_jacobians_finite_difference() {
        let calib = euroc_calib();
        let bias = ImuBias {
            gyro: Vec3F64::new(0.001, -0.002, 0.0005),
            accel: Vec3F64::new(0.01, -0.005, 0.02),
        };
        let gravity = Vec3F64::new(0.0, 0.0, -9.81);

        // Build a non-trivial preintegrated edge: 0.1s at 200Hz with rotation.
        let mut pim = PreintegratedImu::new(bias, calib);
        for k in 0..20 {
            let m = ImuMeasurement {
                timestamp: k as f64 * 0.005,
                gyro: Vec3F64::new(0.1, -0.05, 0.2),
                accel: Vec3F64::new(0.0, 0.0, 9.81),
            };
            pim.integrate(&m, 0.005);
        }

        // Non-trivial states at i and j.
        let make_kf = |rx: f64, ry: f64, rz: f64, tx: f64, ty: f64, tz: f64,
                        vx: f64, vy: f64, vz: f64, bg: Vec3F64, ba: Vec3F64| ViBaKeyframe {
            pose: Pose3d::new(
                SO3F64::exp(Vec3F64::new(rx, ry, rz)).matrix(),
                Vec3F64::new(tx, ty, tz),
            ),
            velocity: Vec3F64::new(vx, vy, vz),
            bias: ImuBias { gyro: bg, accel: ba },
            fixed: false,
        };

        let kf_i = make_kf(0.05, -0.03, 0.01, 0.1, -0.2, 0.05,
                            0.5, 0.1, 0.0, bias.gyro, bias.accel);
        let kf_j = make_kf(-0.02, 0.04, -0.01, 0.2, -0.18, 0.12,
                            0.6, 0.08, 0.01, bias.gyro, bias.accel);

        let (r0, ji_ana, _jj_ana) =
            imu_residual_and_jacobians(&kf_i, &kf_j, &pim, gravity);

        // Finite difference for frame i, velocity component (rows 3..6, cols 6..9).
        // We check a subset for brevity.
        let eps = 1e-6;
        for col in 6..9 {
            let mut kf_i_plus = kf_i.clone();
            let mut kf_i_minus = kf_i.clone();
            match col {
                6 => { kf_i_plus.velocity.x += eps; kf_i_minus.velocity.x -= eps; }
                7 => { kf_i_plus.velocity.y += eps; kf_i_minus.velocity.y -= eps; }
                _ => { kf_i_plus.velocity.z += eps; kf_i_minus.velocity.z -= eps; }
            }
            let (rp, _, _) = imu_residual_and_jacobians(&kf_i_plus, &kf_j, &pim, gravity);
            let (rm, _, _) = imu_residual_and_jacobians(&kf_i_minus, &kf_j, &pim, gravity);

            for row in 3..6 {
                let fd = (rp[row] - rm[row]) / (2.0 * eps);
                let ana = ji_ana[row * 15 + col];
                let err = (fd - ana).abs();
                assert!(
                    err < 1e-5,
                    "IMU Jacobian mismatch at (row={row}, col={col}): \
                     analytical={ana:.8}, fd={fd:.8}, err={err:.2e}"
                );
            }
        }

        // Check bias-accel columns (cols 12..15) for v-residual rows (3..6).
        for col in 12..15 {
            let d_col = col - 12;
            let mut kf_i_plus = kf_i.clone();
            let mut kf_i_minus = kf_i.clone();
            match d_col {
                0 => { kf_i_plus.bias.accel.x += eps; kf_i_minus.bias.accel.x -= eps; }
                1 => { kf_i_plus.bias.accel.y += eps; kf_i_minus.bias.accel.y -= eps; }
                _ => { kf_i_plus.bias.accel.z += eps; kf_i_minus.bias.accel.z -= eps; }
            }
            let (rp, _, _) = imu_residual_and_jacobians(&kf_i_plus, &kf_j, &pim, gravity);
            let (rm, _, _) = imu_residual_and_jacobians(&kf_i_minus, &kf_j, &pim, gravity);

            for row in 3..6 {
                let fd = (rp[row] - rm[row]) / (2.0 * eps);
                let ana = ji_ana[row * 15 + col];
                let err = (fd - ana).abs();
                assert!(
                    err < 1e-5,
                    "Bias-accel Jacobian mismatch at (row={row}, col={col}): \
                     analytical={ana:.8}, fd={fd:.8}, err={err:.2e}"
                );
            }
        }
    }
