// EuRoC stereo visual-inertial with loop closing. Expects the DBoW2 ORB
// vocabulary at weights/ORBvoc.txt in the repository root (a .bin from
// convert_orbvoc also works).
(
    source: Euroc(( data: "../data/euroc/MH_01_easy" )),
    system: (
        version: 1,
        sensors: ( cameras: Stereo, imu: true ),
        pipeline: OrbSlam((
            loop_closing: Enabled(vocabulary: "../weights/ORBvoc.txt"),
        )),
    ),
)
