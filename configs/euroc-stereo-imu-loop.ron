// EuRoC stereo visual-inertial with loop closing: the single EuRoC configuration.
// Expects the DBoW2 ORB vocabulary at weights/ORBvoc.txt in the repository root
// (a .bin from convert_orbvoc also works). Results: experiments/euroc-summary.md.
(
    source: Euroc(( data: "../data/euroc/MH_01_easy" )),
    system: (
        version: 1,
        sensors: ( cameras: Stereo, imu: true ),
        pipeline: OrbSlam((
            loop_closing: Enabled(vocabulary: "../weights/ORBvoc.txt"),
            mapping: (
                execution: Asynchronous,
                keyframe_observations: PnpInliers,
                local_ba: (
                    max_iterations: 7,
                    initial_lambda: 1e-4,
                    merge: PropagateToNewer,
                    outlier_erase: ChiSquare(()),
                ),
            ),
        )),
    ),
    rectification: FixedPoint,
)
