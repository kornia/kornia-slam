// PR #180: pr180-frontend-1ms plus a 10-keyframe local VI-BA window (cards R and T).
// Asynchronous mapping; 7 iterations from lambda 1e-4 in every window (the
// base budget, card V1, as well as the large window); the dense solve on the
// calling thread; each solve's correction carried to the keyframes inserted
// while it ran. Full R_01 (card T, Tam): ATE SE3 0.40-0.46 m, against
// 1.11-1.23 m for pr180-frontend-1ms. Not yet run on the challenge sequences.
//
// Run from the repository root:
//   cargo run --release -p kornia-slam-app -- --config configs/pr180-window10.ron
// Paths below are relative to this file; point `source` at your sequence.
(
    source: Lamaria((
        data: "../data/lamaria/sequence_1_19",
        calib: "../data/lamaria/sequence_1_19/pinhole_calibrations/sequence_1_19.json",
        factory_calib: "../data/lamaria/sequence_1_19/factory_calib.json",
    )),
    system: (
        version: 1,
        sensors: ( cameras: Rig, imu: true ),
        pipeline: OrbSlam((
            frontend: Orb((
                // Half the 2 x 48 tracks `track_refill` caps a rig at; the
                // default 80 would send most frames back to ORB.
                klt_first: Enabled(min_tracks: 48),
                flow_threads: 2,
                klt_rig: AllCameras,
                klt_kernel: WindowedU8,
                klt_window: 11,
                klt_prediction: Enabled(max_level: 0, max_iter: 8),
                klt_retry: CoarseLevel(max_level: 1),
                forward_backward: Enabled(max_round_trip_px: 0.6, max_iter: 4, every_n_frames: 1),
                track_refill: Enabled(per_camera: 48, min_spacing_px: 23.0, refill_below: 0.8, border_px: 9),
                adopt_landmarks: true,
                gyro_guess: RotatedRay,
                flow_pose: AnalyticGn(max_iter: 3),
                flow_bookkeeping: KeyframesOnly,
                // Mapping is not built (lane T step 12).
                keyframe_orb: Tracking,
            )),
            // Card K: no map points from keyframe pairs whose baseline is
            // under tan(1 deg) of the median depth (they only pass the
            // parallax gate as wrong matches); this lets the cold start
            // seed from 20 stereo points (card I, R_11 start-up).
            mapping: ( execution: Asynchronous, growth_min_baseline_ratio: 0.0175, local_ba: ( active_keyframes: 10, max_iterations: 7, initial_lambda: 1e-4, dense_parallelism: Sequential, large_window: Enabled(min_tracked_inliers: 0, active_keyframes: 10, max_iterations: 7, initial_lambda: 1e-4), merge: PropagateToNewer ) ),
            tracking_loss: ( reseed: ( min_cold_start_points: 20 ) ),
            // G11: the analytic refine never adopts an uphill LM step.
            tracking: ( refine_monotone: true ),
        )),
    ),
)
